#!/usr/bin/env bash

# User-editable configuration for the HAMivNPUCore Kind demo.
#
# The `: "${NAME:=default}"` form assigns a default only when NAME is unset or
# empty. A value explicitly exported by the caller therefore takes precedence:
#
#   DRIVER_IMAGE_TAG=my-tag ./demo/kind-vnpu/demo.sh setup

# Directory for generated kubeconfig, rendered YAML, logs, ownership records,
# and runtime.env. Use a new directory for an independent demo run.
: "${DEMO_STATE_DIR:=/tmp/hami-dra-kind-vnpu-demo}"

# Name assigned to the Kind cluster and used as the prefix of node containers.
# List existing names with: kind get clusters
: "${KIND_CLUSTER_NAME:=hami-dra-vnpu-demo}"

# Kubeconfig written by Kind and used by all kubectl/Helm commands in the demo.
# It normally belongs under DEMO_STATE_DIR and does not need manual creation.
: "${KUBECONFIG:=${DEMO_STATE_DIR}/kubeconfig}"

# Upstream ARM64 Kind node image and Kubernetes version used by the cluster.
# Inspect a cached image with:
#   docker image inspect kindest/node:v1.34.0 --format '{{.Architecture}}'
: "${KIND_NODE_IMAGE:=kindest/node:v1.34.0}"

# cgroup v1 Kind image derived directly from KIND_NODE_IMAGE. It configures
# containerd for cgroupfs, enables CDI, and registers the isolated Ascend
# runtime handler. List locally available variants with:
#   docker image ls 'kindest/node*'
: "${CUSTOM_KIND_NODE_IMAGE:=kindest/node:v1.34.0-cgroupfs-cdi-ascend}"

# Kind cgroup policy: auto, cgroupfs, or systemd. `auto` selects cgroupfs for
# Docker cgroup v1 and systemd for cgroup v2. Inspect the host with:
#   docker info --format 'driver={{.CgroupDriver}} version={{.CgroupVersion}}'
: "${KIND_CGROUP_MODE:=auto}"

# Kind CLI version downloaded by prepare-host.sh when `kind` is not on PATH.
# Check an installed binary with: kind version
: "${KIND_VERSION:=v0.30.0}"

# Repository and tag of the DRA kubelet-plugin image. List matching local
# images with: docker image ls projecthami/ascend-dra-driver
: "${DRIVER_IMAGE_REPOSITORY:=projecthami/ascend-dra-driver}"
: "${DRIVER_IMAGE_TAG:=latest}"

# ARM64 CANN development image used when a driver build is required. Confirm
# that it exists and has the correct architecture with:
#   docker image inspect ascendai/cann:9.0.0-devel \
#     --format '{{.Id}} {{.Architecture}}'
: "${CANN_IMAGE:=ascendai/cann:9.0.0-devel}"

# Image used by the two Pods that request NPU resources. It must contain Bash,
# Python 3, ctypes, and an Ascend runtime compatible with the host driver. The
# default follows CANN_IMAGE. Check the basic userspace dependencies with:
#   docker run --rm --entrypoint sh "$WORKLOAD_IMAGE" -c \
#     'command -v bash; command -v python3; python3 -c "import ctypes"'
: "${WORKLOAD_IMAGE:=${CANN_IMAGE}}"

# Go builder version used by the legacy Demo image build path. It should match
# the project requirement. Check the host toolchain with `go version` and the
# cached builder with: docker image inspect "golang:${GOLANG_VERSION}"
: "${GOLANG_VERSION:=1.26.0}"

# Namespace where the DRA driver DaemonSet and Helm release are installed.
# Inspect an existing run with: kubectl get namespaces
: "${DRIVER_NAMESPACE:=ascend-dra-demo}"

# Namespace containing the ResourceClaims and NPU workload Pods.
: "${TEST_NAMESPACE:=ascend-dra-vnpu-demo}"

# Helm release name for the DRA driver. List releases with:
#   helm list --all-namespaces
: "${HELM_RELEASE:=ascend-dra-driver}"

# Whether prepare-host.sh runs the Go unit/build gate before creating Kind.
# Allowed values: true or false. Disable only after validating the same commit.
: "${RUN_GO_TESTS:=true}"

# Whether setup reuses an image when the exact configured reference already
# exists locally. Allowed values: true or false. Inspect references with:
#   docker image ls --digests
: "${SKIP_EXISTING_IMAGE_BUILDS:=true}"

# Space-separated physical NPU Card IDs used for device-share state management.
# Obtain them from the first `NPU` column of: npu-smi info
# Do not use the Device column or /dev/davinciN suffixes. Example: "4 5".
: "${DEVICE_SHARE_CARD_IDS:=}"

# Chip ID within each selected physical card. Single-chip Ascend 310P cards
# normally use 0. Confirm the mapping and logic IDs with: npu-smi info -m
: "${DEVICE_SHARE_CHIP_ID:=0}"
